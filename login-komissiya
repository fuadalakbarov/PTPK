<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PTPK | Komissiya Giriş Paneli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        :root {
            --primary-navy: #0f172a;     /* Komissiya üçün daha rəsmi tünd rəng */
            --brand-blue: #0284c7;       
            --text-dark: #0f172a;        
            --bg-light: #f8fafc;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background: var(--bg-light); display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        
        .login-card {
            background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            width: 100%; max-width: 400px; border-top: 5px solid var(--primary-navy);
        }
        .header { text-align: center; margin-bottom: 30px; }
        .header i { font-size: 40px; color: var(--primary-navy); margin-bottom: 10px; }
        .header h2 { font-size: 22px; color: var(--primary-navy); font-weight: 700; }
        .header p { font-size: 14px; color: #64748b; margin-top: 5px; }

        .form-group { margin-bottom: 20px; position: relative; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px; }
        .form-group input {
            width: 100%; padding: 12px 40px 12px 12px; border: 1px solid #cbd5e1; border-radius: 6px;
            font-size: 14px; transition: 0.2s;
        }
        .form-group input:focus { outline: none; border-color: var(--brand-blue); box-shadow: 0 0 0 3px rgba(2,132,199,0.1); }
        .form-group i.input-icon { position: absolute; right: 12px; top: 38px; color: #94a3b8; }

        .btn {
            width: 100%; padding: 12px; background: var(--primary-navy); color: white; border: none;
            border-radius: 6px; font-size: 15px; font-weight: 600; cursor: pointer; transition: 0.2s;
        }
        .btn:hover { background: #1e293b; }
        
        .alert { padding: 10px; border-radius: 6px; font-size: 13px; margin-bottom: 15px; display: none; text-align: center; }
        .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fca5a5; }
        .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #86efac; }
    </style>
</head>
<body>

<div class="login-card">
    <div class="header">
        <i class="fa-solid fa-building-shield"></i>
        <h2>PTPK Komissiya</h2>
        <p>Ekspert və Komissiya üzvləri üçün giriş</p>
    </div>

    <div id="alertBox" class="alert"></div>

    <div id="stepEmail">
        <div class="form-group">
            <label>Rəsmi Email Ünvanınız</label>
            <input type="email" id="email" placeholder="nümunə@gmail.com">
            <i class="fa-solid fa-envelope input-icon"></i>
        </div>
        <button class="btn" onclick="sendOTP()">Birdəfəlik Şifrə Göndər</button>
    </div>

    <div id="stepOTP" style="display: none;">
        <div class="form-group">
            <label>Emaillə Göndərilən 6 Rəqəmli Kod</label>
            <input type="text" id="otpCode" placeholder="000000" maxlength="6" style="letter-spacing: 5px; text-align: center;">
            <i class="fa-solid fa-key input-icon"></i>
        </div>
        <button class="btn" onclick="verifyOTP()">Sistemə Daxil Ol</button>
    </div>
</div>

<script>
    const alertBox = document.getElementById('alertBox');
    const stepEmail = document.getElementById('stepEmail');
    const stepOTP = document.getElementById('stepOTP');

    function showAlert(msg, type='error') {
        alertBox.innerText = msg;
        alertBox.className = `alert alert-${type}`;
        alertBox.style.display = 'block';
    }

    async function sendOTP() {
        const email = document.getElementById('email').value.trim();
        if(!email) return showAlert("Zəhmət olmasa email ünvanınızı daxil edin.");

        try {
            const res = await fetch('/api/auth/send-otp', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ email })
            });
            const data = await res.json();
            
            if(data.status === 'success') {
                showAlert("Birdəfəlik kod emailinizə göndərildi.", "success");
                stepEmail.style.display = 'none';
                stepOTP.style.display = 'block';
            } else {
                showAlert(data.message || "Xəta baş verdi.");
            }
        } catch(e) {
            showAlert("Serverlə əlaqə kəsildi.");
        }
    }

    async function verifyOTP() {
        const email = document.getElementById('email').value.trim();
        const code = document.getElementById('otpCode').value.trim();
        if(!code) return showAlert("Kodu daxil edin.");

        try {
            const res = await fetch('/api/auth/verify-otp', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ email, code })
            });
            const data = await res.json();

            if(data.status === 'success') {
                // ƏSAS YOXILANIŞ: Daxil olan istifadəçinin rolu "komissiya" olmalıdır
                if(data.role !== 'komissiya') {
                    showAlert("Giriş rədd edildi: Bu səhifə yalnız komissiya üzvləri üçündür.");
                    return;
                }

                localStorage.setItem('ptpk_token', data.token);
                localStorage.setItem('ptpk_role', data.role);
                localStorage.setItem('ptpk_name', data.full_name);
                
                showAlert("Giriş uğurludur! Yönləndirilirsiniz...", "success");
                setTimeout(() => {
                    window.location.href = '/komissiya';
                }, 1000);
            } else {
                showAlert(data.message || "Kod yanlışdır.");
            }
        } catch(e) {
            showAlert("Xəta baş verdi.");
        }
    }
</script>
</body>
</html>
