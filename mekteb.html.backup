        <div class="panel-layout">

            <div class="panel-col">
                <div class="section-title"><i class="fa-solid fa-list-check"></i> Reyestr siyahısı (Təsdiqlənənlər)</div>
                <div class="table-container">

                    <div class="placeholder-box" id="securityBox">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Məxfiliyin tam qorunması məqsədilə yuxarıdakı süzgəcdən rəsmi məktəbinizi seçin.<br><br>
                        <span style="font-size:12px; font-weight:500; color:#64748b;">Hər ümumtəhsil müəssisəsi yalnız öz məktəbinə aid olan təsdiqlənmiş komissiya qərarlarına baxa bilər.</span></span>
                    </div>

                    <div class="placeholder-box empty" id="emptyBox" style="display:none;">
                        <i class="fa-solid fa-inbox"></i>
                        Bu məktəb üzrə komissiya tərəfindən hələ ki rəsmiləşmiş (Təsdiqlənmiş) qərar tapılmadı.
                    </div>

                    <table class="excel-table" id="mektebTable" style="display:none;">
                        <thead>
                            <tr>
                                <th style="width:30%">Şagirdin S.A.A.</th>
                                <th style="width:14%">FİN Kodu</th>
                                <th style="width:12%">Tədris İli</th>
                                <th style="width:16%">Müraciət Növü</th>
                                <th style="width:14%">Komissiya Statusu</th>
                                <th style="width:14%">Təhsil Forması</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody"></tbody>
                    </table>
                </div>
            </div>

            <div class="panel-col">
                <div class="section-title"><i class="fa-solid fa-circle-info"></i> Rəsmi Çıxarış və Qərar Panel</div>
                <div class="preview-container">
                    <div class="right-body" id="emptyRight"
                         style="display:flex; align-items:center; justify-content:center;
                                height:100%; color:var(--text-muted); text-align:center;
                                font-size:13px; font-weight:600;">
                        Qərarı görmək və PDF formatında endirmək üçün soldakı siyahıdan şagirdin üzərinə klikləyin.
                    </div>
                    
                    <div class="right-body" id="detailPanel" style="display:none;">
                        <div class="info-block">
                            <strong>Şagirdin Tam Adı</strong>
                            <span id="d-name" style="font-size:15px; font-weight:700; color:var(--primary-navy);">-</span>
                        </div>
                        <div class="info-block">
                            <strong>FİN Kodu</strong>
                            <span id="d-fin">-</span>
                        </div>
                        <div class="info-block">
                            <strong>Təhsil Müəssisəsi</strong>
                            <span id="d-school" style="font-size:12px; color:var(--text-muted); font-weight:500;">-</span>
                        </div>
                        <div class="info-block">
                            <strong>Tədris İli / Müraciət</strong>
                            <span id="d-year-type">-</span>
                        </div>
                        <div class="info-block">
                            <strong>Komissiya Qərarı</strong>
                            <span id="d-decision">-</span>
                        </div>
                        <div class="info-block">
                            <strong>Qərarın Qüvvədə Olma Müddəti</strong>
                            <span id="d-expiry">-</span>
                        </div>
                        <div class="info-block">
                            <strong>Təyin Olunan Təhsil Forması</strong>
                            <span id="d-form" style="font-weight:700; color:var(--brand-blue);">-</span>
                        </div>

                        <div id="commissionBox" class="commission-box" style="display:none;">
                            <h4><i class="fa-solid fa-comment-medical"></i> Katib/Komissiya Ekspertiza Qeydi</h4>
                            <p id="d-notes">-</p>
                        </div>

                        <button id="printBtn" class="btn-download-pdf" onclick="downloadDecisionPDF()" disabled>
                            <i class="fa-solid fa-file-pdf"></i> Rəsmi Qərarı Endir / Çap Et
                        </button>
                        <button id="excelSingleBtn" class="btn-download-pdf" onclick="exportExcelSingle()" disabled
                                style="background:#107c41; margin-top:6px;">
                            <i class="fa-solid fa-file-excel"></i> Excel Kimi Endir (.xls)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="printable-blank">
    <div class="p-header">
        <h2 style="font-size:18px; letter-spacing:0.5px;">AZƏRBAYCAN RESPUBLİKASI ELM VƏ TƏHSİL NAZİRLİYİ</h2>
        <h3 style="font-size:15px; margin-top:5px; color:#333;">Psixoloji-Tibbi-Pedaqoji Komissiyası — Rəsmi Çıxarış Qərarı</h3>
    </div>
    <div style="font-size:14px; line-height:2.4; margin-top:25px;">
        <p><strong>Məktəb/Müəssisə:</strong> <span id="p-school" style="border-bottom:1px dashed #000; padding-bottom:2px;"></span></p>
        <p><strong>Şagirdin S.A.A.:</strong> <span id="p-name" style="font-weight:bold; border-bottom:1px dashed #000; padding-bottom:2px;"></span></p>
        <p><strong>FİN Kodu:</strong> <span id="p-fin" style="font-family:monospace; font-weight:bold;"></span></p>
        <p><strong>Tədris İli:</strong> <span id="p-year"></span></p>
        <p><strong>Müraciət Kateqoriyası:</strong> <span id="p-type"></span></p>
        <p><strong>Komissiya Statusu:</strong> <span style="color:green; font-weight:bold;">Təsdiqlənib (Qüvvədədir)</span></p>
        <p><strong>Təyin Edilmiş Təhsil Forması:</strong> <span id="p-form" style="font-weight:bold; text-decoration:underline;"></span></p>
        <p><strong>Qərarın Müddəti:</strong> <span id="p-expiry"></span></p>
        <p style="margin-top:20px; font-weight:bold;">Komissiyanın Xüsusi Rəyi və Qeydləri:</p>
        <p id="p-notes" style="border:1px solid #333; padding:15px; background:#fff; min-height:90px; line-height:1.6; margin-top:5px; border-radius:4px;"></p>
    </div>
    <div class="p-footer">
        <span>Komissiya Katibi: ______________</span>
        <span>Tarix: 2026-cı il</span>
    </div>
</div>

<script>
    let allApplications = [];
    let selectedApp = null;

    function loadApplicationsFromStorage() { /* eski - artiq islenmeyecek */
        try {
            allApplications = window._serverData || [];
        } catch(e) {
            allApplications = [];
        }
    }

    async function onSchoolChange() { try { const r = await fetch("http://127.0.0.1:8001/api/komissiya/get-applications"); window._serverData = await r.json(); } catch(e) { window._serverData = []; }
        const schoolValue = document.getElementById('schoolFilter').value;
        const searchInput = document.getElementById('studentSearch');
        const excelBtn = document.getElementById('excelBtn');

        clearDetailPanel();

        if (!schoolValue) {
            document.getElementById('securityBox').style.display = 'flex';
            document.getElementById('emptyBox').style.display = 'none';
            document.getElementById('mektebTable').style.display = 'none';
            searchInput.disabled = true;
            excelBtn.disabled = true;
            document.getElementById('stat-ok').textContent = '0';
            return;
        }

        searchInput.value = '';
        searchInput.disabled = false;
        excelBtn.disabled = false;
        renderTable();
    }

    function renderTable() {
        const selectedSchool = document.getElementById('schoolFilter').value;
        const searchKeyword = document.getElementById('studentSearch').value.trim().toUpperCase();

        loadApplicationsFromStorage();

        // 1. TƏHLÜKƏSİZLİK: Yalnız süzgəcdə seçilmiş məktəbin şagirdləri göstərilir.
        // 2. STATUS SÜZGƏCİ: Yalnız komissiya statusu "Təsdiqləndi" (Qüvvədədir) olan sənədlər görünür.
        const validStatuses = ['Təsdiqləndi', 'Qüvvədədir', 'Təsdiq edildi', 'Aktiv'];
        let filtered = allApplications.filter(app => {
            const schoolMatch = (app.schoolText || '').trim() === selectedSchool.trim();
            const statusMatch = validStatuses.includes(app.decisionStatus) ||
                                (app.decisionStatus && app.decisionStatus.includes('Qüvvəd'));
            return schoolMatch && statusMatch;
        });
        
        if (searchKeyword) {
            filtered = filtered.filter(app => (app.name || '').toUpperCase().includes(searchKeyword));
        }

        const tbody = document.getElementById('tableBody');
        const secBox  = document.getElementById('securityBox');
        const emptyBox = document.getElementById('emptyBox');
        const table   = document.getElementById('mektebTable');

        tbody.innerHTML = '';

        if (filtered.length === 0) {
            secBox.style.display = 'none';
            emptyBox.style.display = 'flex';
            table.style.display = 'none';
            document.getElementById('stat-ok').textContent = '0';
            return;
        }

        secBox.style.display = 'none';
        emptyBox.style.display = 'none';
        table.style.display = 'table';

        let count = 0;

        filtered.forEach(app => {
            count++;
            const tr = document.createElement('tr');
            tr.className = 'student-row';
            tr.onclick = () => activateRowAndShowDetails(app, tr);

            const statusBadge = `<span class="pill" style="background:#dcfce7; color:#15803d;">Qüvvədədir</span>`;
            const eduFormText = (app.educationForm && app.educationForm !== '-') ? app.educationForm : 'Qeyd edilməyib';

            tr.innerHTML = `
                <td><strong>${app.name || '-'}</strong></td>
                <td style="font-family:monospace; font-weight:700;">${app.fin || '-'}</td>
                <td>${app.year || '-'}</td>
                <td>${app.type || '-'}</td>
                <td>${statusBadge}</td>
                <td style="color:#0284c7; font-weight:700;">${eduFormText}</td>
            `;
            tbody.appendChild(tr);
        });
        function downloadDecisionPDF(id) {
    const app = window._allApps ? window._allApps.find(a => a.id === id) : null;
    if(!app) { alert("Məlumat tapılmadı!"); return; }

    const pdfContent = `==================================================
        PSİXOLOJİ-TİBBİ-PEDAQOJİ KOMİSSİYA
          GƏNCƏ-DAŞKƏSƏN REGİONAL TƏHSİL İDARƏSİ
==================================================
MÜƏSSİSƏ: ${app.schoolText}
TƏDRİS İLİ: ${app.year}
ŞAGİRD (S.A.A): ${app.name}
FİN KOD: ${app.fin}
--------------------------------------------------
QƏRARIN STATUSU: ${app.decisionStatus || 'Gözləmədə'}
TƏHSİL FORMASI QƏRARI: ${app.educationForm}
QÜVVƏDƏ OLMA MÜDDƏTİ: ${app.expiryDate || '-'}
--------------------------------------------------
KOMİSSİYA EKSPERT DİAQNOZU VƏ RƏYİ:
"${app.notes || 'Rəsmi rəy qeyd edilməmişdir.'}"
--------------------------------------------------
Tarix: ${new Date().toLocaleDateString('az-AZ')}
==================================================`;

    const blob = new Blob([pdfContent], { type: "text/plain;charset=utf-8" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `${app.fin}_PTPK_Rey.txt`;
    link.click();
}

    // PDF sənədini endirmək funksiyası (Rəsmi Çıxarış şablonu ilə)
    function downloadDecisionPDF() {
        if (!selectedApp) return;
        const app = selectedApp;

        // Komissiyada əllə yüklənmiş fayl varsa — birbaşa onu endir
        if (app.hasManualFile && app.manualFileData && app.manualFileData.length > 100) {
            const link = document.createElement('a');
            link.href = app.manualFileData;
            link.download = 'Rəsmi_Qərar_' + (app.manualFileName || app.fin + '.pdf');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        // hasManualFile=true amma məlumat yoxdursa — xəbərdarlıq
        if (app.hasManualFile && (!app.manualFileData || app.manualFileData.length <= 100)) {
            if (!confirm("⚠️ Bu şagird üçün yüklənmiş PDF fayl yaddaşda tapılmadı (həcm limiti səbəbi ilə). Əvəzinə sistem şablonu çap ediləcək. Davam etmək istəyirsiniz?")) return;
        }

        // Fayl yoxdursa — öz şablonunu çap et
        document.getElementById('p-school').textContent   = app.schoolText || '-';
        document.getElementById('p-name').textContent     = app.name || '-';
        document.getElementById('p-fin').textContent      = app.fin || '-';
        document.getElementById('p-year').textContent     = app.year || '-';
        document.getElementById('p-type').textContent     = app.type || '-';
        document.getElementById('p-form').textContent     = app.educationForm || '-';
        document.getElementById('p-expiry').textContent   = app.expiryDate || 'Daimi';
        document.getElementById('p-notes').textContent    = app.notes || 'Komissiya tərəfindən hər hansı bir əlavə xüsusi rəy daxil edilməmişdir.';
        window.print();
    }

    function exportExcel() {
        const table = document.getElementById('mektebTable');
        const schoolName = document.getElementById('schoolFilter').value;
        const cleanName = schoolName.replace(/[^a-zA-Z0-9_əıöğçşƏİÖĞÇŞ]/g, "_");
        
        const a = document.createElement('a');
        a.href = 'data:application/vnd.ms-excel,\ufeff' + table.outerHTML.replace(/ /g,'%20');
        a.download = `PTPK_Qerarlar_${cleanName}.xls`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    function exportExcelSingle() {
        if (!selectedApp) return;
        const app = selectedApp;
        const rows = [
            ['Şagirdin S.A.A.', 'FİN Kodu', 'Məktəb', 'Tədris İli', 'Müraciət Növü', 'Komissiya Statusu', 'Təhsil Forması', 'Müddət', 'Komissiya Rəyi'],
            [
                app.name || '-',
                app.fin || '-',
                app.schoolText || '-',
                app.year || '-',
                app.type || '-',
                'Qüvvədədir',
                (app.educationForm && app.educationForm !== '-') ? app.educationForm : 'Təyin edilməyib',
                (app.expiryDate && app.expiryDate !== '-') ? app.expiryDate : 'Daimi',
                app.notes || '-'
            ]
        ];
        let html = '<table border="1"><thead>';
        html += '<tr>' + rows[0].map(h => `<th style="background:#0f172a;color:#fff;font-weight:bold;">${h}</th>`).join('') + '</tr>';
        html += '</thead><tbody>';
        html += '<tr>' + rows[1].map(c => `<td>${c}</td>`).join('') + '</tr>';
        html += '</tbody></table>';

        const cleanFin = (app.fin || 'unknown').replace(/[^a-zA-Z0-9]/g, '_');
        const a = document.createElement('a');
        a.href = 'data:application/vnd.ms-excel,\ufeff' + encodeURIComponent(html);
        a.download = `PTPK_${cleanFin}_Qerar.xls`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
</body>
</html>