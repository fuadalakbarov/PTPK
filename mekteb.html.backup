<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PTPK | Məktəb Portalı</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --primary-navy: #0f172a;
            --brand-blue: #0284c7;
            --text-dark: #0f172a;
            --text-muted: #475569;
            --success-green: #16a34a;
            --excel-green: #107c41;
            --danger-red: #dc2626;
            --warning-orange: #d97706;
        }

        * { box-sizing: border-box; font-family: 'Inter', sans-serif; margin: 0; padding: 0; }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            background-attachment: fixed;
            height: 100vh; width: 100vw; overflow: hidden;
            display: flex; flex-direction: column;
            justify-content: center; align-items: center; padding: 20px;
        }

        .app-window {
            display: flex; width: 100%; max-width: 1600px; height: 88vh;
            background: #fff; border-radius: 14px;
            border: 2px solid var(--primary-navy);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4); overflow: hidden;
        }

        /* Sidebar */
        .nav-sidebar {
            width: 70px; display: flex; flex-direction: column; align-items: center;
            justify-content: space-between; padding: 20px 0;
            background: #f8fafc; border-right: 2px solid #e2e8f0; flex-shrink: 0;
        }
        .nav-item {
            width: 44px; height: 44px; border-radius: 10px; display: flex;
            justify-content: center; align-items: center;
            color: var(--text-muted); font-size: 16px; cursor: pointer;
            transition: all 0.2s; text-decoration: none;
        }
        .nav-item:hover { background: #e2e8f0; color: var(--primary-navy); }
        .nav-item.active { background: var(--brand-blue); color: #fff; }

        /* Viewport */
        .viewport {
            flex: 1; padding: 20px 25px;
            display: flex; flex-direction: column;
            background: #fff; height: 100%; overflow: hidden;
        }

        /* Header */
        .brand-header {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 12px; border-bottom: 2px solid #e2e8f0; flex-shrink: 0;
        }
        .brand-logo-area { display: flex; align-items: center; gap: 12px; }
        .brand-logo { height: 38px; }
        .brand-text h1 { font-size: 18px; font-weight: 700; color: var(--primary-navy); }

        .school-stats { display: flex; gap: 10px; }
        .stat-chip {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 14px; border-radius: 6px;
            font-size: 12px; font-weight: 700; border: 1px solid #cbd5e1;
        }
        .stat-chip.total { background: #f1f5f9; color: var(--primary-navy); }

        /* Controls */
        .controls-row {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 12px; gap: 12px; flex-shrink: 0;
            background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0;
        }
        .filter-group { display: flex; align-items: center; gap: 10px; flex: 1; }

        .select-school-filter {
            flex: 1; max-width: 620px; padding: 8px 12px;
            font-size: 13px; font-weight: 600;
            border: 2px solid var(--primary-navy); border-radius: 6px;
            color: var(--primary-navy); outline: none;
            background: #fff; cursor: pointer; appearance: auto;
        }

        .search-wrap { position: relative; max-width: 280px; width: 100%; }
        .search-input {
            width: 100%; padding: 8px 12px 8px 35px;
            font-size: 13px; font-weight: 600;
            border: 2px solid var(--primary-navy); border-radius: 6px;
            color: var(--primary-navy); outline: none;
        }
        .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--primary-navy); }

        .btn-excel {
            display: flex; align-items: center; gap: 6px;
            background: var(--excel-green); color: #fff;
            border: 1px solid #0b592e; padding: 8px 14px;
            font-size: 12px; font-weight: 700; border-radius: 6px; cursor: pointer;
        }
        .btn-excel:hover { background: #0e6c38; }
        .btn-excel:disabled { background: #cbd5e1; border-color: #cbd5e1; cursor: not-allowed; }

        /* Panel */
        .panel-layout {
            flex: 1; display: grid; grid-template-columns: 2.5fr 1fr;
            gap: 20px; margin-top: 12px; overflow: hidden;
        }
        .panel-col { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
        .section-title {
            font-size: 12px; font-weight: 700;
            color: var(--primary-navy); margin-bottom: 6px; text-transform: uppercase;
        }

        /* Table container */
        .table-container {
            flex: 1; overflow: auto;
            border: 2px solid var(--primary-navy); border-radius: 6px; background: #fff;
        }
        .excel-table { width: 100%; border-collapse: collapse; font-size: 13px; text-align: left; }
        .excel-table th {
            background: var(--primary-navy); color: #fff; font-weight: 700;
            padding: 10px; position: sticky; top: 0; z-index: 10;
        }
        .student-row { cursor: pointer; transition: background 0.15s; background: #fff; }
        .student-row:nth-child(even) { background: #f8fafc; }
        .student-row:hover, .student-row.active { background: #f0fdf4 !important; }
        .student-row td { padding: 9px 10px; border: 1px solid #e2e8f0; font-weight: 500; }

        /* Placeholder boxes */
        .placeholder-box {
            display: flex; flex-direction: column; align-items: center;
            justify-content: center; height: 100%;
            color: var(--text-muted); font-size: 14px; font-weight: 600;
            text-align: center; padding: 40px; gap: 14px;
        }
        .placeholder-box i { font-size: 46px; color: var(--brand-blue); }
        .placeholder-box.empty i { font-size: 36px; color: #cbd5e1; }

        /* Pills */
        .pill {
            font-size: 11px; font-weight: 700; padding: 3px 8px;
            border-radius: 4px; display: inline-block; white-space: nowrap;
        }
        .pill.quvve  { background: #e0f2fe; color: #0369a1; }

        /* Right panel */
        .preview-container {
            border: 2px solid var(--brand-blue); border-radius: 6px;
            background: #fff; display: flex; flex-direction: column;
            height: 100%; overflow: hidden;
        }
        .right-body { flex: 1; overflow-y: auto; padding: 14px; }

        .info-block { margin-bottom: 10px; }
        .info-block strong {
            font-size: 10px; text-transform: uppercase;
            color: var(--text-muted); display: block; margin-bottom: 2px; letter-spacing: 0.4px;
        }
        .info-block span { font-size: 13px; font-weight: 600; color: var(--text-dark); }

        .commission-box {
            margin-top: 12px; padding: 10px 12px;
            background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px;
        }
        .commission-box h4 { font-size: 11px; color: var(--brand-blue); margin-bottom: 6px; font-weight: 700; }
        .commission-box p  { font-size: 12px; font-weight: 500; color: var(--text-dark); line-height: 1.5; }

        /* Action Buttons */
        .btn-download-pdf {
            width: 100%; background: var(--brand-blue); color: #fff;
            height: 40px; border: none; border-radius: 6px;
            font-size: 13px; font-weight: 700; cursor: pointer;
            display: flex; justify-content: center; align-items: center;
            gap: 8px; margin-top: 12px; transition: background 0.2s;
        }
        .btn-download-pdf:hover { background: #0369a1; }
        .btn-download-pdf:disabled { background: #cbd5e1; cursor: not-allowed; }

        /* Gizli Çap Sahəsi */
        #printable-blank { display: none; }
        @media print {
            body * { visibility: hidden; }
            #printable-blank, #printable-blank * { visibility: visible; }
            #printable-blank {
                position: absolute; left: 0; top: 0;
                width: 100%; padding: 40px; display: block !important;
                color: #000 !important; background: #fff !important;
            }
            .p-header { text-align: center; margin-bottom: 35px; border-bottom: 3px double #000; padding-bottom: 15px; }
            .p-footer { margin-top: 50px; display: flex; justify-content: space-between; font-weight: bold; }
        }
    </style>
</head>
<body>

<div class="app-window">

    <div class="nav-sidebar">
        <div>
            <a href="index.html" class="nav-item" title="Sənəd Qəbul Formasına Qayıt">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </div>
        <div class="nav-item active" title="Məktəb Portalı">
            <i class="fa-solid fa-school"></i>
        </div>
        <div></div>
    </div>

    <div class="viewport">

        <div class="brand-header">
            <div class="brand-logo-area">
                <img src="image.png" alt="PTPK" class="brand-logo">
                <div class="brand-text">
                    <h1>Məktəb Sənəd Monitorinq Portalı</h1>
                </div>
            </div>
            <div class="school-stats">
                <div class="stat-chip total">Qüvvədə olan Qərarlar: <span id="stat-ok" style="color:var(--brand-blue); font-weight:700; margin-left:3px;">0</span></div>
            </div>
        </div>

        <div class="controls-row">
            <div class="filter-group">
                <select id="schoolFilter" class="select-school-filter" onchange="onSchoolChange()">
                    <option value="">— Müəssisə Girişi üçün Siyahıdan Məktəbinizi Seçin —</option>

                    <optgroup label="🏢 GƏNCƏ ŞƏHƏRI">
                        <option value="Gəncə şəhər İ.Qayıbov adına 1 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər İ.Qayıbov adına 1 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər Ə.Cavad adına 2 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər Ə.Cavad adına 2 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 3 nömrəli tam orta ümumtəhsil məktəb-liseyi">Gəncə şəhər 3 nömrəli tam orta ümumtəhsil məktəb-liseyi</option>
                        <option value="Gəncə şəhər M.Mehdizadə adına 4 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Mehdizadə adına 4 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.Ə.Sabir adına 5 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Ə.Sabir adına 5 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər C.Cabbarlı adına 6 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər C.Cabbarlı adına 6 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 7 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər 7 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.P.Vaqif adına 8 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.P.Vaqif adına 8 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 9 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər 9 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.Hadi adına 10 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Hadi adına 10 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər N.Gəncəvi adına 11 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər N.Gəncəvi adına 11 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər V.Əliyev adına 12 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər V.Əliyev adına 12 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər H.Əliyev adına 13 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər H.Əliyev adına 13 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.Müşfiq adına 14 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Müşfiq adına 14 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.Əzizbəyov adına 15 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Əzizbəyov adına 15 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.Ş.Vazeh adına 16 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.Ş.Vazeh adına 16 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 17 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər 17 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər N.Aydın adına 18 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər N.Aydın adına 18 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 19 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər 19 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər M.A.Abbaszadə adına 20 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər M.A.Abbaszadə adına 20 nömrəli tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə şəhər 21 nömrəli tam orta ümumtəhsil məktəbi">Gəncə şəhər 21 nömrəli tam orta ümumtəhsil məktəbi</option>
