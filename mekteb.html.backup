                        <option value="Quşqara kənd tam orta ümumtəhsil məktəbi">Quşqara kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Balçılı kənd tam orta ümumtəhsil məktəbi">Balçılı kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Almalı kənd tam orta ümumtəhsil məktəbi">Almalı kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Çaykənd kənd tam orta ümumtəhsil məktəbi">Çaykənd kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Çaylı kənd tam orta ümumtəhsil məktəbi">Çaylı kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Dozular kənd tam orta ümumtəhsil məktəbi">Dozular kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Gəncə kənd tam orta ümumtəhsil məktəbi">Gəncə kənd tam orta ümumtəhsil məktəbi</option>
                        <option value="Göykənd kənd ümumi orta məktəbi">Göykənd kənd ümumi orta məktəbi</option>
